APP_NAME="Spring Water Dairy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_OWNER_EMAIL=owner@springwaterdairy.local
APP_OWNER_PASSWORD=change-me-immediately

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spring_water_dairy
DB_USERNAME=swd
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://localhost:7700

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@springwaterdairy.local
MAIL_FROM_NAME="Spring Water Dairy"

# Sanctum
SANCTUM_EXPIRATION=1440

# SMS (Africa's Talking by default)
SMS_PROVIDER=africas_talking
AT_USERNAME=null
AT_API_KEY=null

# Rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15

# Backup
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30
